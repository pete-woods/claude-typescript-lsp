{
  "typescript": {
    "command": "pnpx",
    "args": ["--silent", "--package=typescript@7", "tsc", "--lsp", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    },
    "startupTimeout": 120000
  }
}
